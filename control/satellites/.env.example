# Backend REST API base URL (control plane). Served by nginx, which strips the
# /api prefix and proxies to Drogon. Used for /status/all, /satellite, /delay,
# /stream/rate.
VITE_API_BASE=http://localhost:8848/api

# Backend WebSocket URL (position data plane). Proxied by nginx to Drogon's
# /ws/positions controller.
VITE_WS_URL=ws://localhost:8848/ws/positions
